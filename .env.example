# 天地图浏览器端 Key（申请地址：https://console.tianditu.gov.cn/api/key）
# 使用方法：复制本文件为 .env，然后填入你的 Key
VITE_TIANDITU_KEY=*****

# Cesium ion 访问令牌（申请地址：https://ion.cesium.com/tokens）
# 需要加载 Cesium World Terrain（配合“地形突出”功能）时填入；留空则不加载地形
VITE_CESIUM_ION_ACCESS_TOKEN=*****

# RustFS / S3 凭据（用于 scripts/upload_terrain.py 上传 DEM 切片）
# 使用方法：复制本文件为 .env，填入账号密码后通过环境变量传入脚本（例如在 shell 中 `export $(grep -v '^#' .env | xargs)`，或借助 python-dotenv）
RUSTFS_DEV_ACCESS_KEY=*****
RUSTFS_DEV_SECRET_KEY=*****

# DEM 地形服务（quantized-mesh，RustFS/MinIO/S3 等 S3 兼容存储均可）
# 使用方法：复制本文件为 .env，填入服务根地址与可选 Token；重启 dev 服务器即可
# 浏览器请求同源路径，由 Vite dev/preview 代理转发，避免目标服务缺少 CORS 头
VITE_DEM_SERVICE_URL=/terrain/guangxi/
# Vite 配置专用：真实 DEM 服务源地址，不会暴露给浏览器端 import.meta.env
DEM_PROXY_TARGET=
# 可选：留空则不携带 Authorization 头；启用后通过 Authorization: Bearer 头发送
VITE_DEM_SERVICE_TOKEN=
